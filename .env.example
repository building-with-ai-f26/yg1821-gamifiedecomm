# Copy this file to .env and fill in your keys:
#   cp .env.example .env
# NEVER commit your actual .env file to Git! On Render, put these in the service's Environment settings instead.

# Claude API key from https://console.anthropic.com (API Keys page). Used by server.js to generate quiz questions.
ANTHROPIC_API_KEY=sk-ant-replace-with-your-key

# Which Claude model writes the quiz. Start cheap with Haiku; switch to claude-opus-5-5 for higher quality.
ANTHROPIC_MODEL=claude-haiku-5-5

# Database. Leave empty locally to use data/db.json. On Render, paste your Neon connection string
# (Neon dashboard > Connection string, starts with postgresql://...?sslmode=require).
DATABASE_URL=

# Sign-in emails (Brevo, https://app.brevo.com > SMTP & API > API keys). Leave empty locally:
# sign-in links are then printed in the terminal and shown on screen instead of emailed.
BREVO_API_KEY=
# The sender address you verified in Brevo (Senders, domains & dedicated IPs > Senders).
MAIL_FROM=you@example.com

# Emails allowed into the brand admin panel (/admin), comma-separated.
ADMIN_EMAILS=you@example.com

# Public address of the app, used in sign-in links. Locally: http://localhost:3000. On Render: your onrender.com URL.
APP_URL=http://localhost:3000

# Optional: max AI quiz generations per day across all players (protects your API credit). Default 300.
AI_DAILY_LIMIT=300

# Optional: port for the local app (default 3000; Render sets this itself)
PORT=3000

# Course template key (not used by this app)
OPENROUTER_API_KEY=sk-or-v1-replace-with-your-key
